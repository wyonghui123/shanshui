# ============================================================
# Python 编译产物
# ============================================================
__pycache__/
*.py[cod]
*$py.class

# ============================================================
# 操作系统
# ============================================================
.DS_Store
Thumbs.db

# ============================================================
# 宿主环境产物（非本仓库内容）
# ============================================================
.trae-html-share-packages/

# ============================================================
# 音频与二进制素材（体积大，且每台 PC 各自持有一份即可）
#
# 本仓库只跟踪「代码 + 声法表 JSON + 页面 HTML/JS」。
# 以下两类不入库：
#   1) 采样素材（data/source/**、dist/audio/**）——原始录音 200MB+
#   2) 渲染产物与历史归档（_archive/**、dist/** 下的音频）
#
# 协作约定：每台 PC 的 data/source/ 素材保持一致且不变。
# 若日后需要升级素材，改用「素材版本清单 + 独立下载」的方式管理，
# 不要把大二进制直接塞进 Git 历史。
# ============================================================

# --- 音频格式 ---
*.wav
*.mp3
*.ogg
*.m4a
*.flac
*.aac
*.aiff
*.aif
*.opus
*.wma

# --- 归档压缩包（历史分享包等）---
*.zip
*.7z
*.rar
*.tar
*.gz
*.tgz

# --- NumPy 数组（探针/中间产物）---
*.npy
*.npz

# --- 渲染出的位图产物（可由 src 重新生成，23 张 PNG ≈ 35MB）---
# 这些是 dist/ 下的**输出**，不是源码；每台 PC 跑一次渲染即可复现。
dist/figures/

# ============================================================
# 历史归档：整目录不入库
#
# _archive/ 是历次探针与分享包的堆放处（370MB），内含浏览器 profile
# （Edge/Chrome 缓存、LevelDB 锁文件、GPU 模型二进制）等**完全无价值**
# 的第三方垃圾，且路径深到触发 Windows「文件名过长」而无法 git add。
# 这些是一次性诊断产物，不构成协作资产。
# ============================================================
_archive/

# ============================================================
# 探针与临时脚本
# ============================================================
_probe/

# ============================================================
# 编辑器 / IDE
# ============================================================
.vscode/
.idea/
*.swp
*.swo